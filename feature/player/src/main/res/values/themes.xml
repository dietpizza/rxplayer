<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The player is always pure black (plan §9), from the very first window frame. -->
    <style name="Theme.Rx.Player" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
