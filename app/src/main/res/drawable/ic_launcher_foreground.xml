<?xml version="1.0" encoding="utf-8"?>
<!--
    Rounded white play triangle overlapping a small rounded-square "photo" glyph.
    Everything stays inside the 66dp safe zone centred at (54,54).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Photo card -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M33,46H47A7,7 0,0 1,54 53V67A7,7 0,0 1,47 74H33A7,7 0,0 1,26 67V53A7,7 0,0 1,33 46Z" />
    <!-- Sun -->
    <path
        android:fillColor="@color/rx_coral"
        android:pathData="M30.5,54a3.5,3.5 0,1 0,7 0a3.5,3.5 0,1 0,-7 0Z" />
    <!-- Mountains -->
    <path
        android:fillColor="@color/rx_coral"
        android:pathData="M29.5,70.5L36,62.5L40,66.5L43.5,62.5L50,70.5Z"
        android:strokeColor="@color/rx_coral"
        android:strokeWidth="1.5"
        android:strokeLineJoin="round" />

    <!-- Coral halo separating the play glyph from the photo card -->
    <path
        android:fillColor="@color/rx_coral"
        android:pathData="M52,37L77,52L52,67Z"
        android:strokeColor="@color/rx_coral"
        android:strokeWidth="15"
        android:strokeLineJoin="round" />
    <!-- Play triangle; the round-joined stroke gives it soft corners -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M52,37L77,52L52,67Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="8"
        android:strokeLineJoin="round" />
</vector>
